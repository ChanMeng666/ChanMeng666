# Normalize all text files to LF in the repo and working tree.
# The build runs on Linux CI and all generators (scripts/*.mjs) write LF,
# so enforcing LF stops the Windows autocrlf churn that made generated
# files (linkedin/*.md, llms*.txt, dist/*.json) show as modified with no
# real content change.
* text=auto eol=lf

# Explicit binaries — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
# A .docx is a ZIP. `* text=auto` above would probably sniff it as binary via
# its NUL bytes, but this repo pins its binaries rather than trusting the
# heuristic — a CRLF-normalised .docx is silently corrupt, and the one in
# cv/exports/ is what gets uploaded to job portals.
*.docx binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.mp4  binary
*.webm binary
